{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "start": "next start",
    "dev": "portless run --name website next dev",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "clean": "rm -rf .next out node_modules",
    "generate:resume": "node scripts/generate-resume.ts",
    "test": "node --test scripts/*.test.ts",
    "test:e2e": "playwright test",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit --base main",
    "prepare": "husky"
  },
  "dependencies": {
    "cn": "^0.3.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/playwright": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "fallow": "^3.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-config-awesomeness": "^4.6.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^7.0.2003",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "zod-compiler": "^1.28.0"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version",
    "last 1 Safari version",
    "last 1 Edge version"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
